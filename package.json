{
  "name": "st-guitar-chord-board",
  "version": "0.20.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:browser": "playwright test",
    "test:webkit": "playwright test --project=webkit-iphone",
    "test:offline": "playwright test --project=chromium-offline",
    "test:release": "playwright test --config=playwright.release.config.js",
    "vendor:guitar-audio": "node scripts/vendor-guitar-soundfont.mjs",
    "build:release": "npm run vendor:guitar-audio && node scripts/build-release.mjs",
    "serve": "python3 -m http.server 4173",
    "serve:release": "python3 -m http.server 4174 --directory dist"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "tonal": "6.4.3"
  },
  "engines": { "node": ">=20" }
}
